# Gitignore do DM-Cerberus / Cerebro Engine
# Dev Maniac's Systems — Helbert Moura

# Pastas temporárias e processadas
raw/processed/*/
!raw/processed/.gitkeep

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Temporários e backups
*.bak
*.tmp
*.swp
*.swo
*~
.~lock.*

# Logs
*.log

# Binários grandes
*.pdf
*.zip
*.rar
*.7z
*.tar.gz

# Editor e IDEs
.vscode/
.idea/
*.iml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.cerberus/

# Node
node_modules/
dist/
build/

# Ambiente e credenciais locais
.env
.env.local
*.local

# Bases de projetos privadas (preservadas localmente no disco, ignoradas pelo Git)
projects/*
!projects/README.md
!projects/example-project/
!projects/example-project/**

# Wiki privada e infraestrutura interna (preservadas localmente, ignoradas pelo Git)
wiki/*
!wiki/README.md
!wiki/protocolo-triade-agentes.md

# Documentos operacionais locais e relatórios internos
BRAIN.md
HANDOVER.md
MEMORY.md
DECISIONS.md
archive/
reports/
prompts/
scratch/
