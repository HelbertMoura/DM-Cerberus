# Cerberus Memory Intelligence — Inspector environment template
# Phase P3.5 · Production deployment template
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
# All values shown below are placeholders — replace them with strong
# secrets in any deployment.

# --- Core -------------------------------------------------------------------
# Canonical directory that holds `.cerberus/` (DB + inbox + users.json)
# and the Markdown corpus to be indexed.
CERBERUS_ROOT=./data

# --- Network ---------------------------------------------------------------
# Inspector binds to 0.0.0.0:7331 inside the container (proxied by
# Cloudflared tunnel or compose `ports:` mapping to 127.0.0.1).
CERBERUS_UI_HOST=0.0.0.0
CERBERUS_UI_PORT=7331

# Set to 1 only when you have a LAN-routable network trust boundary in
# place. Defaults to 0 (loopback-only).
CERBERUS_UI_ALLOW_LAN=1

# FIX-007: when behind Cloudflare / any TLS-terminating reverse proxy,
# set these to 1 so the server trusts the upstream's
# `X-Forwarded-Proto` / `CF-Connecting-IP` headers and marks the
# session cookie as `Secure`. Always set TRUST_PROXY=1 in production
# when going through Cloudflare; never set it for direct LAN exposure.
CERBERUS_TRUST_PROXY=1
CERBERUS_SECURE_COOKIES=1

# --- Security --------------------------------------------------------------
# REQUIRED: HMAC key for signed session cookies.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CERBERUS_SECRET_KEY=replace-me-with-a-48-byte-random-token

# REQUIRED: initial admin email + password for the seeded user.
# The engine NEVER hardcodes these — see `engine/auth.py:_resolve_admin_credentials`.
# Change the password immediately after first login (`/auth/login`).
CERBERUS_ADMIN_EMAIL=admin@devmaniacs.com.br
CERBERUS_ADMIN_PASSWORD=replace-me-with-a-strong-password-min-12-chars

# --- Cloudflare Tunnel (named) ---------------------------------------------
# REQUIRED for `cloudflared` profile. Generate via:
#   1. Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
#      (type: Cloudflared) — pick "Named" and follow the install command
#      for Docker; it gives you a token like:
#      eyJhIjoixxxxxxx...
#   2. Paste the token below.
#   3. Add a Public Hostname that points to http://cerberus:7331
#      (the compose service name).
#   4. Bring the stack up with: `docker compose --profile tunnel up -d`
#      (cloudflared profile is "default" once the token is set).
CLOUDFLARE_TUNNEL_TOKEN=replace-me-with-the-token-from-cloudflare-zero-trust

# --- Operator escape hatches -----------------------------------------------
# 1 = disable authentication entirely (dev / tests only — NEVER in prod).
CERBERUS_AUTH_DISABLE=0

# Tini / uvicorn-style verbosity. 0=quiet, 1=info, 2=debug.
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONIOENCODING=utf-8