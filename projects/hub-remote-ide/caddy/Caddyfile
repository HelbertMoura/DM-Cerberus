# =============================================================
# Caddy — reverse proxy do code-server
# TLS termina no Cloudflare Tunnel (não precisa daqui)
# =============================================================

:8080 {
    reverse_proxy code-server:8443 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    encode gzip zstd

    # Logs estruturados
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
