# ============================================================
# DEV MANIAC'S HUB — Variáveis de ambiente (template)
# Copie este arquivo para `.env` e preencha com suas chaves.
# NUNCA commite o `.env` (já está no .gitignore).
# ============================================================

# Z.AI / GLM 5.3 (modelo principal do projeto Hub)
# Solicite em: https://z.ai → API Keys
ZAI_API_KEY=cole-sua-chave-aqui

# MiniMax M3 (fallback / modelo secundário)
# Já configurada no Hermes global, mas pode duplicar aqui
MINIMAX_API_KEY=cole-sua-chave-aqui

# Google OAuth (login social — opcional)
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Cloudflare (já tem nas memórias do Hermes, mas opcional aqui)
# Usado pelo tunnel definitivo hub.devmaniacs.com.br
CLOUDFLARE_API_TOKEN=seu-token-cloudflare
CLOUDFLARE_ACCOUNT_ID=seu-account-id
CLOUDFLARE_TUNNEL_ID=id-do-tunnel-permanente
CLOUDFLARE_TUNNEL_SECRET=secret-do-tunnel

# Hub config
HUB_DOMAIN=hub.devmaniacs.com.br
HUB_PORT=8765
HUB_SESSION_SECRET=cole-um-secret-aleatorio-de-64-chars
