# =============================================================
# Dev Maniac's Hub — variáveis de ambiente (Fase 1)
# Copie este arquivo para .env e preencha.
# NUNCA commitar .env (já está no .gitignore)
# =============================================================

# Senha forte pro PostgreSQL (gere com: openssl rand -hex 32)
POSTGRES_PASSWORD=cole-senha-forte-aqui

# Senha inicial do code-server (VSCode web)
CODE_PASSWORD=cole-senha-forte-aqui

# Timezone
TZ=America/Sao_Paulo

# Google OAuth (próximo passo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret do NextAuth
NEXTAUTH_SECRET=
