---
/**
 * Watermark — padrão sutil de pontos cyan no fundo.
 * Fixo, full-screen, atrás de todo conteúdo.
 */
---

<svg class="auth-watermark" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id="dm-dots" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1.5" fill="#08B9CA" opacity="0.12"/>
    </pattern>
    <radialGradient id="dm-fade" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="white" stop-opacity="1"/>
      <stop offset="100%" stop-color="white" stop-opacity="0"/>
    </radialGradient>
    <mask id="dm-mask">
      <rect width="100%" height="100%" fill="url(#dm-fade)"/>
    </mask>
  </defs>
  <rect width="100%" height="100%" fill="url(#dm-dots)" mask="url(#dm-mask)"/>
</svg>
