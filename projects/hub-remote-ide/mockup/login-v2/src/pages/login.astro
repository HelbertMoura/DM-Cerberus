---
/**
 * Página /login — entrada principal do Hub.
 * Mobile-first com breakpoint desktop em 960px.
 *
 * Estrutura:
 * - <auth-shell>    = card central com mascote + form (dentro do sistema)
 * - <page-footer>  = fora do card, navegação pública (status) + copyright
 * - <auth-watermark> = fora do card, marca d'água de fundo
 */
import AuthLayout from '../layouts/AuthLayout.astro';
import Mascot from '../components/Mascot.astro';
import Footer from '../components/Footer.astro';
import AuthForm from '../components/AuthForm.tsx';
import '../styles/login-page.css';
---

<AuthLayout title="Hub Remoto de IDEs — Dev Maniac's Systems">
  <main class="auth-shell">
    <!-- Coluna esquerda: mascote (mobile: topo / desktop: lado) -->
    <div class="auth-left">
      <Mascot />
    </div>

    <!-- Coluna direita: APENAS o conteúdo do login (título + form) -->
    <div class="auth-right">
      <header class="auth-header">
        <h1 class="auth-title">Hub Remoto de IDEs</h1>
        <p class="auth-sub">Seu painel unificado — acesso único a partir de qualquer lugar.</p>
      </header>

      <AuthForm client:load />
    </div>
  </main>

  <!-- Footer FORA do card de login — navegação pública + copyright -->
  <Footer />

  <script>
    // Se já tem cookie SSO válido, pula direto pro Hub.
    (function () {
      try {
        var has = document.cookie.split('; ').some(function (c) {
          return c.indexOf('dm_sso=') === 0 || c.indexOf('DMHUBSESSID=') === 0;
        });
        if (has) {
          window.location.replace('/hub.html');
        }
      } catch (_) {}
    })();
  </script>
</AuthLayout>