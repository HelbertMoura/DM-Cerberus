{
  "name": "Dev Maniac's Hub",
  "short_name": "DM Hub",
  "description": "Hub remoto de IDEs da Dev Maniac's — Gemini, M3, Z.AI",
  "id": "/",
  "start_url": "/dashboard.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#061637",
  "theme_color": "#061637",
  "categories": ["developer", "productivity", "utilities"],
  "lang": "pt-BR",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "../assets/brand/dev-maniacs-mark.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../assets/brand/dev-maniacs-mark.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "../assets/brand/dev-maniacs-mark.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Antigravity 2.0",
      "short_name": "Gemini",
      "description": "Abrir Antigravity IDE",
      "url": "/dashboard.html?ide=antigravity",
      "icons": [
        {
          "src": "../assets/brand/dev-maniacs-mark.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "MiniMax Code",
      "short_name": "M3",
      "description": "Abrir MiniMax Code",
      "url": "/dashboard.html?ide=m3",
      "icons": [
        {
          "src": "../assets/brand/dev-maniacs-mark.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Z.AI Code",
      "short_name": "Z.AI",
      "description": "Abrir Z.AI Code",
      "url": "/dashboard.html?ide=zai",
      "icons": [
        {
          "src": "../assets/brand/dev-maniacs-mark.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "../assets/brand/dev-maniacs-social-card.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DM Hub dashboard"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "display_override": ["window-controls-overlay", "minimal-ui", "standalone"]
}
